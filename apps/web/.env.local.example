# ─────────────────────────────────────────────
# Iterra web (Next.js) environment.
# Copy to apps/web/.env.local. For backend (FastAPI) vars see the root .env.example.
# These three sections together are everything the web app reads from process.env.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Supabase — required for auth and waitlist
# Get these from: Supabase dashboard → Project Settings → API
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─────────────────────────────────────────────
# API connectivity
# ─────────────────────────────────────────────
# Leave NEXT_PUBLIC_API_URL unset while running `next dev`: the browser uses the
# same-origin /api/v1 path, which Next rewrites to FastAPI via API_PROXY_TARGET.
# Set it to a full URL (e.g. http://localhost:8000) only for direct cross-origin calls.
NEXT_PUBLIC_API_URL=
# Rewrite target from the Next.js server to FastAPI (Compose service name inside Docker).
API_PROXY_TARGET=http://127.0.0.1:8000

# ─────────────────────────────────────────────
# Admin UI gating
# ─────────────────────────────────────────────
# Comma-separated emails granted the /admin UI. Must mirror ADMIN_EMAILS on the backend.
NEXT_PUBLIC_ADMIN_EMAILS=

# ─────────────────────────────────────────────
# Supabase setup checklist (run once in dashboard)
# ─────────────────────────────────────────────
# 1. Create project at supabase.com
#
# 2. Enable Google OAuth:
#    Authentication → Providers → Google → Enable
#    (needs Google Cloud OAuth 2.0 credentials)
#
# 3. Enable LinkedIn OAuth:
#    Authentication → Providers → LinkedIn (OIDC) → Enable
#    (needs LinkedIn App credentials)
#
# 4. Add site URL + redirect URL:
#    Authentication → URL Configuration
#    Site URL: http://localhost:3000  (or your prod domain)
#    Redirect URL: http://localhost:3000/auth/callback
#
# 5. Create waitlist table (run in SQL Editor):
#
#    CREATE TABLE IF NOT EXISTS waitlist (
#      id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
#      email       text NOT NULL UNIQUE,
#      name        text,
#      profession  text,
#      created_at  timestamptz NOT NULL DEFAULT now()
#    );
#
#    -- Allow anyone to join the waitlist (no auth required)
#    ALTER TABLE waitlist ENABLE ROW LEVEL SECURITY;
#
#    CREATE POLICY "allow_insert"
#      ON waitlist FOR INSERT
#      TO anon, authenticated
#      WITH CHECK (true);
#
#    CREATE POLICY "allow_select"
#      ON waitlist FOR SELECT
#      TO anon, authenticated
#      USING (true);
